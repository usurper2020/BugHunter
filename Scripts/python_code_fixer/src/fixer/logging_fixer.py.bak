# logging_fixer.py

import logging
from pathlib import Path
from typing import Dict, List, Tuple, Set
import ast
import re
import difflib
from dataclasses import dataclass

@dataclass
class LoggingIssue:
    line_number: int
    line_content: str
    issue_type: str
    suggested_fix: str

class LoggingFixer:
    def __init__(self):
        self.logger = logging.getLogger("BugHunter.LoggingFixer")
        self.logging_patterns = {
            'fstring_logging': r'logging\.[a-zA-Z]+\(f["\'].*?["\']',
            'concat_logging': r'logging\.[a-zA-Z]+\(.*?\s*\+\s*.*?\)',
            'format_logging': r'logging\.[a-zA-Z]+\(.*?\.format\(.*?\)\)',
            'percent_logging': r'logging\.[a-zA-Z]+\(.*?%.*?\)',
            'no_logger_name': r'logging\.getLogger\(\s*\)',
        }

    def analyze_file(self, file_path: Path) -> Tuple[bool, List[LoggingIssue]]:
        """Analyzes file for logging issues without making changes"""
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.readlines()

            issues = []
            for line_num, line in enumerate(content, 1):
                # Check for f-string in logging
                if re.search(self.logging_patterns['fstring_logging'], line):
                    fixed_line = self._convert_fstring_to_percent(line)
                    issues.append(LoggingIssue(
                        line_num,
                        line.strip(),
                        'fstring_logging',
                        fixed_line.strip()
                    ))
                
                # Check for string concatenation in logging
                if re.search(self.logging_patterns['concat_logging'], line):
                    fixed_line = self._convert_concat_to_percent(line)
                    issues.append(LoggingIssue(
                        line_num,
                        line.strip(),
                        'concat_logging',
                        fixed_line.strip()
                    ))
                
                # Check for .format() in logging
                if re.search(self.logging_patterns['format_logging'], line):
                    fixed_line = self._convert_format_to_percent(line)
                    issues.append(LoggingIssue(
                        line_num,
                        line.strip(),
                        'format_logging',
                        fixed_line.strip()
                    ))
                
                # Check for unnamed loggers
                if re.search(self.logging_patterns['no_logger_name'], line):
                    fixed_line = line.replace('getLogger()', 'getLogger(__name__)')
                    issues.append(LoggingIssue(
                        line_num,
                        line.strip(),
                        'unnamed_logger',
                        fixed_line.strip()
                    ))

            return bool(issues), issues

        except Exception as e:
            self.logger.error(f"Error analyzing logging issues: {str(e)}")
            return True, [LoggingIssue(0, "", "error", str(e))]

    def fix(self, file_path: Path) -> bool:
        needs_fix, issues = self.analyze_file(file_path)
        
        if not needs_fix:
            print(f"\n✓ {file_path} - No logging fixes needed")
            return True

        print(f"\n! {file_path} - Logging issues found:")
        for issue in issues:
            print(f"\nLine {issue.line_number}:")
            print(f"Current:  {issue.line_content}")
            print(f"Suggested: {issue.suggested_fix}")
            print(f"Issue: {issue.issue_type.replace('_', ' ').title()}")

        fix_choice = input("\nWould you like to fix these issues? (y/n): ")
        if fix_choice.lower() != 'y':
            return False

        return self._apply_fixes(file_path, issues)

    def _convert_fstring_to_percent(self, line: str) -> str:
        """Converts f-string logging to %-formatting"""
        # Extract the f-string content
        match = re.search(r'f["\'](.+?)["\']', line)
        if match:
            content = match.group(1)
            # Replace f-string expressions with %s
            new_content = re.sub(r'{(.+?)}', '%s', content)
            # Extract the expressions
            expressions = re.findall(r'{(.+?)}', content)
            # Create the %-formatting string
            if expressions:
                return line.replace(f'f"{content}"', f'"{new_content}", {", ".join(expressions)}')
        return line

    def _convert_concat_to_percent(self, line: str) -> str:
        """Converts string concatenation to %-formatting"""
        # This is a simplified version - real implementation would be more complex
        return line.replace(' + ', ' % ')

    def _convert_format_to_percent(self, line: str) -> str:
        """Converts .format() to %-formatting"""
        # This is a simplified version - real implementation would be more complex
        return re.sub(r'\.format\((.*?)\)', r' % (\1)', line)

    def _apply_fixes(self, file_path: Path, issues: List[LoggingIssue]) -> bool:
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.readlines()

            fixed_content = content.copy()
            
            for issue in issues:
                print(f"\nFix for line {issue.line_number}:")
                print(f"Current:  {issue.line_content}")
                print(f"Suggested: {issue.suggested_fix}")
                print("\nOptions:")
                print("1. Apply suggested fix")
                print("2. Enter custom fix")
                print("3. Skip this issue")
                
                choice = input("Choose option (1-3): ")
                
                if choice == '1':
                    fixed_content[issue.line_number - 1] = issue.suggested_fix + '\n'
                elif choice == '2':
                    custom_fix = input("Enter custom fix: ")
                    fixed_content[issue.line_number - 1] = custom_fix + '\n'

            # Show diff
            diff = list(difflib.unified_diff(
                content,
                fixed_content,
                fromfile=str(file_path),
                tofile=f"{file_path} (fixed)"
            ))

            if diff:
                print("\nProposed changes:")
                for line in diff:
                    print(line, end='')
                
                apply_choice = input("\nApply these changes? (y/n): ")
                if apply_choice.lower() != 'y':
                    return False

                return self._write_fixed_content(file_path, fixed_content)
            
            return True

        except Exception as e:
            self.logger.error(f"Error fixing logging issues: {str(e)}")
            return False

    def _write_fixed_content(self, file_path: Path, content: List[str]) -> bool:
        try:
            # Create backup
            backup_path = file_path.with_suffix('.py.bak')
            with open(backup_path, 'w', encoding='utf-8') as f:
                f.writelines(content)

            # Write fixed content
            with open(file_path, 'w', encoding='utf-8') as f:
                f.writelines(content)

            print(f"\nFixed content written to {file_path}")
            print(f"Backup saved to {backup_path}")
            return True
        except Exception as e:
            self.logger.error(f"Error writing fixed content: {str(e)}")
            return False